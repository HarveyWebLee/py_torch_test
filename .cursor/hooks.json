{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bash .cursor/hooks/format-python.sh",
        "matcher": "Write|StrReplace|EditNotebook"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash .cursor/hooks/guard-destructive-git.sh",
        "matcher": "git push --force|git reset --hard|git clean -f",
        "failClosed": false
      }
    ],
    "sessionStart": [
      {
        "command": "bash .cursor/hooks/session-context.sh"
      }
    ]
  }
}
